# RPC da rede Base (pode ser o teu endpoint Alchemy)
RPC_URL=https://mainnet.base.org

# Gemini (chave gratuita do Google AI Studio). Opcional aqui: também a podes colar na janela e guardá-la (gemini.key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# 1 = o Gemini "pensa" antes de decidir (mais preciso, mais lento); 0 = desligado
GEMINI_THINKING=1
# O bot descobre sozinho os modelos Gemini/Gemma da tua chave e roda por todos quando um esgota a quota.
# Para forçar uma lista (por ordem de preferência), descomenta:
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-flash-lite-latest
# Se o Gemini ficar indisponível com posição aberta, fecha-a ao fim de X minutos (0 = nunca)
GEMINI_FALHA_FECHAR_MIN=30

# Modo: 0 = simulação, 1 = REAL (a janela também tem a caixa "Modo REAL")
LIVE_TRADING=0

# Valores iniciais dos parâmetros. Na janela podes alterá-los (ficam em settings.json e passam a mandar).
SIM_CAPITAL_WETH=0.1
TRADE_WETH=0.01
# Máximo do capital que o Gemini pode usar numa ordem (ele escolhe a fração)
ORDER_PCT=100
MIN_CONFIDENCE=0.6
SLIPPAGE_PCT=0.5
MAX_TOTAL_LOSS_PCT=5
LOOP_SECONDS=60
COOLDOWN_SECONDS=120
MAX_CONSECUTIVE_LOSSES=3

# Fixos (só .env)
FEE_PCT=0.05
MIN_ETH_GAS=0.0005
# POOL_FEE=500   # opcional: força o fee tier (100/500/3000/10000); vazio = deteta sozinho
